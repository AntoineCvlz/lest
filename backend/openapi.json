          "cache": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Cache",
            "type": "string"
          },
          "database": {
            "enum": [
              "ok",
              "down"
            ],
            "title": "Database",
            "type": "string"
          }
        },
        "required": [
          "database",
          "cache"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
