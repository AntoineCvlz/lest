            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ProfileIn": {
        "properties": {
          "goal": {
            "enum": [
              "gain",
              "maintain",
              "cut"
            ],
            "title": "Goal",
            "type": "string"
          },
          "height_m": {
            "maximum": 2.5,
            "minimum": 1.0,
            "title": "Height M",
            "type": "number"
          },
          "unit_system": {
            "enum": [
              "metric",
              "imperial"
            ],
            "title": "Unit System",
            "type": "string"
          }
        },
        "required": [
          "height_m",
          "goal",
          "unit_system"
        ],
        "title": "ProfileIn",
        "type": "object"
      },
      "ProfileOut": {
        "properties": {
          "goal": {
            "enum": [
              "gain",
              "maintain",
              "cut"
            ],
            "title": "Goal",
            "type": "string"
          },
          "height_m": {
            "title": "Height M",
            "type": "number"
          },
          "onboarded_at": {
            "format": "date-time",
            "title": "Onboarded At",
            "type": "string"
          },
          "unit_system": {
            "enum": [
              "metric",
              "imperial"
            ],
            "title": "Unit System",
            "type": "string"
          }
        },
        "required": [
          "height_m",
          "goal",
          "unit_system",
          "onboarded_at"
        ],
        "title": "ProfileOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerJWTAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
