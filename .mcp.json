{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--allowed-origins",
        "http://localhost:3000;http://localhost:3100;http://localhost:8000;http://localhost:8025",
        "--output-dir",
        ".playwright-mcp"
      ],
      "env": {}
    }
  }
}
