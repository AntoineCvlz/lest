# Copier en `.env` (ignoré par git) : `cp .env.example .env`, puis ajuster.
# Valeurs de DÉVELOPPEMENT uniquement : ne jamais les réutiliser ailleurs.

# --- Django ---------------------------------------------------------------------------
# Clé de signature (sessions, CSRF, jetons). Générer une valeur propre à votre poste :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi-cle-de-dev-uniquement

# Clé privée RSA (≥ 3072 bits, PEM) qui signe les jetons JWT, sur une ligne avec des « \n ».
# Vide en dev : une clé locale est créée au premier démarrage (backend/jwt-dev.pem, ignoré).
# Obligatoire en prod. Générer :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | awk '{printf "%s\\n", $0}'
JWT_PRIVATE_KEY=

# Prod seulement (service `web`) : en-tête où le proxy de bord (Caddy…) écrit l'IP du
# navigateur en écrasant celle du client, ex. `x-forwarded-for`. Vide en dev et en E2E :
# le BFF ne transmet alors aucune IP et Django compte celle du proxy.
TRUSTED_CLIENT_IP_HEADER=
# Prod seulement (service `web`) : origine(s) publique(s) acceptée(s) pour les écritures, ex.
# `https://lest.example`. En dev, Compose la déduit de WEB_PORT.
PUBLIC_ORIGIN=

# Adresse publique du front (citée dans certains e-mails de compte) et expéditeur des e-mails.
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=Lest <no-reply@lest.local>

# --- PostgreSQL -----------------------------------------------------------------------
POSTGRES_USER=lest
POSTGRES_PASSWORD=lest-dev-password
POSTGRES_DB=lest

# --- Ports publiés sur l'hôte (127.0.0.1 uniquement) -----------------------------------
# À changer si le port est déjà pris sur votre machine.
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432
MAILPIT_UI_PORT=8025
